# Relative database paths resolve from backend/, regardless of your terminal directory.
CHAT_DATABASE_PATH=data/chat.sqlite3
CHAT_SESSION_DAYS=30
CHAT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OPENAI_API_KEY=
CHAT_OPENAI_MODEL=gpt-4.1-mini
CHAT_AI_TURNS_PER_HOUR=30
CHAT_AI_MAX_OUTPUT_TOKENS=600
CHAT_ADMIN_TOKEN=
CHAT_SMTP_HOST=smtp.gmail.com
CHAT_SMTP_PORT=587
CHAT_SMTP_USERNAME=awaisabdullahm@gmail.com
CHAT_SMTP_PASSWORD=
CHAT_SMTP_FROM=awaisabdullahm@gmail.com
CHAT_NOTIFICATION_TO=awaisabdullahm@gmail.com
CHAT_EMAIL_CHAT_DIGESTS=true
CHAT_DIGEST_IDLE_MINUTES=10
# Forwarded IP headers are ignored unless the transport peer is in this explicit list.
CHAT_TRUSTED_PROXY_CIDRS=[]
